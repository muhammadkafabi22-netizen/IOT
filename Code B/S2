
#include <WiFi.h>
#include <HTTPClient.h>
#include <algorithm>
#include <math.h>

// WIFI
const char* ssid = "Wokwi-GUEST";
const char* password = "";

// HTTP SERVER
const char* serverURL = "http://httpbin.org/post";

// PARAMETER S2
const int TOTAL_PESAN = 100;
const int PAYLOAD_SIZE = 500;
const unsigned long INTERVAL = 2000;
const unsigned long TIMEOUT = 5000;

const int LDR_PIN = 34;

// STATISTIK
float rttData[TOTAL_PESAN];
int jumlahBerhasil = 0;
int jumlahGagal = 0;

// MEMBUAT PAYLOAD TEPAT 500 BYTE
String createPayload(int seq, int ldr) {
  char buffer[PAYLOAD_SIZE + 1];

  snprintf(buffer, sizeof(buffer), "S2,%04d,%04d", seq, ldr);

  String payload = String(buffer);

  while (payload.length() < PAYLOAD_SIZE) {
    payload += "X";
  }

  return payload;
}

// STATISTIK HASIL
void tampilkanHasil() {
  float data[TOTAL_PESAN];

  for (int i = 0; i < jumlahBerhasil; i++) {
    data[i] = rttData[i];
  }

  float mean = 0;
  float median = 0;
  float stdDev = 0;
  float p95 = 0;

  if (jumlahBerhasil > 0) {
    std::sort(data, data + jumlahBerhasil);

    float total = 0;

    for (int i = 0; i < jumlahBerhasil; i++) {
      total += data[i];
    }

    mean = total / jumlahBerhasil;

    if (jumlahBerhasil % 2 == 0) {
      median = (data[jumlahBerhasil / 2 - 1] +
                data[jumlahBerhasil / 2]) / 2.0;
    } else {
      median = data[jumlahBerhasil / 2];
    }

    float variance = 0;

    for (int i = 0; i < jumlahBerhasil; i++) {
      variance += pow(data[i] - mean, 2);
    }

    stdDev = sqrt(variance / jumlahBerhasil);

    int indexP95 = ceil(0.95 * jumlahBerhasil) - 1;

    if (indexP95 < 0) indexP95 = 0;
    if (indexP95 >= jumlahBerhasil) {
      indexP95 = jumlahBerhasil - 1;
    }

    p95 = data[indexP95];
  }

  float pdr = (float)jumlahBerhasil /
              TOTAL_PESAN * 100.0;

  Serial.println("\n========== HASIL S2 ==========");

  Serial.print("Pesan dikirim : ");
  Serial.println(TOTAL_PESAN);

  Serial.print("Berhasil      : ");
  Serial.println(jumlahBerhasil);

  Serial.print("Gagal         : ");
  Serial.println(jumlahGagal);

  Serial.print("PDR           : ");
  Serial.print(pdr, 2);
  Serial.println(" %");

  Serial.print("RTT Mean      : ");
  Serial.print(mean, 2);
  Serial.println(" ms");

  Serial.print("RTT Median    : ");
  Serial.print(median, 2);
  Serial.println(" ms");

  Serial.print("RTT Std Dev   : ");
  Serial.print(stdDev, 2);
  Serial.println(" ms");

  Serial.print("RTT P95       : ");
  Serial.print(p95, 2);
  Serial.println(" ms");

  Serial.println("==============================");
  Serial.println("\nPENGUJIAN S2 SELESAI");
}

// PENGUJIAN HTTP POST S2
void testHTTP_S2() {
  Serial.println("\n===== PENGUJIAN S2 =====");
  Serial.println("Protokol : HTTP POST");
  Serial.println("Payload  : 500 Byte");
  Serial.println("Pesan    : 100");

  for (int seq = 1; seq <= TOTAL_PESAN; seq++) {

    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("WiFi terputus. Menghubungkan ulang...");

      WiFi.begin(ssid, password, 6);

      unsigned long mulaiWiFi = millis();

      while (WiFi.status() != WL_CONNECTED &&
             millis() - mulaiWiFi < TIMEOUT) {
        delay(100);
      }
    }

    if (WiFi.status() != WL_CONNECTED) {
      jumlahGagal++;
      Serial.print("Pesan ");
      Serial.print(seq);
      Serial.println(" | WIFI GAGAL");
    } else {

      int ldrValue = analogRead(LDR_PIN);
      String payload = createPayload(seq, ldrValue);

      WiFiClient client;
      HTTPClient http;

      http.setConnectTimeout(TIMEOUT);
      http.setTimeout(TIMEOUT);
      http.setReuse(false);

      bool beginOK = http.begin(client, serverURL);

      if (!beginOK) {
        jumlahGagal++;

        Serial.print("Pesan ");
        Serial.print(seq);
        Serial.println(" | HTTP BEGIN GAGAL");

      } else {

        http.addHeader("Content-Type", "text/plain");

        unsigned long waktuMulai = millis();

        int httpCode = http.POST(
          (uint8_t*)payload.c_str(),
          payload.length()
        );

        unsigned long waktuSelesai = millis();

        float rtt = waktuSelesai - waktuMulai;

        Serial.print("Pesan ");
        Serial.print(seq);
        Serial.print(" | Payload: ");
        Serial.print(payload.length());
        Serial.print(" byte | ");

        if (httpCode >= 200 && httpCode < 300) {

          rttData[jumlahBerhasil] = rtt;
          jumlahBerhasil++;

          Serial.print("RTT: ");
          Serial.print(rtt, 2);
          Serial.println(" ms | BERHASIL");

        } else {

          jumlahGagal++;

          Serial.print("HTTP Code: ");
          Serial.print(httpCode);
          Serial.println(" | GAGAL");
        }

        http.end();
      }
    }

    // INTERVAL 2 DETIK
    if (seq < TOTAL_PESAN) {
      delay(INTERVAL);
    }
  }

  tampilkanHasil();
}

void setup() {
  Serial.begin(115200);
  pinMode(LDR_PIN, INPUT);

  Serial.println("\n===== S2 HTTP POST =====");

  WiFi.begin(ssid, password, 6);

  Serial.print("Menghubungkan WiFi");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi Connected");

  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());

  Serial.print("RSSI: ");
  Serial.print(WiFi.RSSI());
  Serial.println(" dBm");

  testHTTP_S2();
}

void loop() {
}
